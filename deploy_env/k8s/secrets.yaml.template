# secrets.yaml.template
#
# このファイルをコピーして secrets.yaml を作成してください。
# secrets.yaml は .gitignore に追加し、絶対にコミットしないでください。
#
# 値は base64 エンコードして入力してください:
#   echo -n 'your-value' | base64
#
# 適用方法:
#   kubectl apply -f secrets.yaml

apiVersion: v1
kind: Secret
metadata:
  name: app-secrets
  namespace: iki-project
type: Opaque
data:
  # MariaDB
  DB_ROOT_PASSWORD: <base64-encoded>
  DB_NAME: <base64-encoded>
  DB_USER: <base64-encoded>
  DB_PASSWORD: <base64-encoded>

  # Counter (Rails)
  SECRET_KEY_BASE: <base64-encoded>

  # Nginx (Google Maps)
  GOOGLE_MAPS_API_KEY: <base64-encoded>

  # Grafana
  GF_SECURITY_ADMIN_USER: <base64-encoded>
  GF_SECURITY_ADMIN_PASSWORD: <base64-encoded>

  # Cloudflare Tunnel
  TUNNEL_TOKEN: <base64-encoded>
